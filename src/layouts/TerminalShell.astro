---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import { withBase } from '../lib/base';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  boot?: boolean;
}
const { title = 'v01d@cyber', boot = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    {/* 客户端路由：导航不卸载 JS —— BGM 的 Audio 常驻，切页播放不断 */}
    <ClientRouter prefetch />
    <script is:inline>
      // 本地偏好冷加载重放（跑在首屏渲染前，防闪）：CRT 开关 + 连接态 + 深夜
      try {
        if (localStorage.getItem('crt') === 'off') document.documentElement.dataset.crt = 'off';
        if (localStorage.getItem('net') === 'wired') document.documentElement.classList.add('wired');
      } catch {}
      if (new Date().getHours() < 5) document.documentElement.dataset.night = '1';
    </script>
  </head>
  <body>
    <div class="crt" aria-hidden="true"></div>
    <header class="winbar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="wintitle">v01d@cyber — zsh</span>
      <button id="bgm-ind" class="bgm" title="mpg123 — bôa 「Duvet」">♪</button>
      <a class="homelink" href={withBase('/')}>~/ghost</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>v01d@cyber · Astro 手写 · 视觉版权归原作者（lain / GITS / Bebop …）</span>
      <span class="hud-right">
        <button id="hud-count"></button>
        <span id="hud-clock" aria-hidden="true">--:--:--</span>
      </span>
    </footer>
    <script>
      // 窗口栏：时钟 + BGM 指示器 + 深夜检测 + 无解释倒计时。虚拟导航换掉整个
      // body，每次 page-load 对新元素重绑；冷加载时脚本先于 astro:page-load
      // 执行，直接调一次（marker 防双绑）
      import { bgmToggle, bgmResume, syncBgmIndicator, bgmSetDucked } from '../lib/bgm';
      import { applyNet } from '../lib/net';
      import { webStores, isNight } from '../lib/visitor';
      import { nextEvent, hudLabel } from '../lib/countdown';

      let clockTimer: ReturnType<typeof setInterval> | undefined;
      let nightOn = isNight(new Date());
      // 深夜态重放 + 跨界检测：0:00 入夜、5:00 天亮，广播 night:change（hero 换池）
      const syncNight = (announce: boolean) => {
        const now = isNight(new Date());
        if (now) document.documentElement.dataset.night = '1';
        else delete document.documentElement.dataset.night;
        if (announce && now !== nightOn) dispatchEvent(new CustomEvent('night:change', { detail: now }));
        nightOn = now;
      };
      const syncShell = () => {
        // 虚拟导航会把 <html> 属性同步成服务端版本，本地偏好重放
        try {
          if (localStorage.getItem('crt') === 'off') document.documentElement.dataset.crt = 'off';
        } catch {}
        // 连接态同样重放（冷加载已由 head 内联脚本处理，这里管虚拟导航）
        bgmSetDucked(applyNet(document.documentElement, webStores().ls));
        syncNight(false);
        const clock = document.getElementById('hud-clock');
        if (clock) {
          clearInterval(clockTimer);
          const tick = () => {
            clock.textContent = new Date().toLocaleTimeString('zh-CN', { hour12: false });
            syncNight(true);
          };
          tick();
          clockTimer = setInterval(tick, 1000);
        }
        // 无解释倒计时：只给 T-n。点击把那句话交给终端说
        const count = document.getElementById('hud-count');
        if (count && !count.dataset.bind) {
          count.dataset.bind = '1';
          const paint = () => {
            const r = nextEvent(new Date());
            if (!r) {
              count.hidden = true;
              return;
            }
            count.textContent = hudLabel(r.days);
            if (r.days === 0) count.dataset.doom = '1';
            count.dataset.line = r.event.line;
          };
          paint();
          count.addEventListener('click', () => {
            if (count.dataset.line) dispatchEvent(new CustomEvent('term:print', { detail: count.dataset.line }));
          });
        }
        const ind = document.getElementById('bgm-ind');
        if (ind && !ind.dataset.bind) {
          ind.dataset.bind = '1';
          ind.addEventListener('click', () => bgmToggle());
        }
        syncBgmIndicator();
      };
      document.addEventListener('astro:page-load', syncShell);
      syncShell();
      bgmResume();
    </script>
  </body>
</html>
