---
import type { Ctx, Entry } from '../lib/commands';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  notes: CollectionEntry<'notes'>[];
  lab: CollectionEntry<'lab'>[];
}
const { posts, notes, lab } = Astro.props;

const toEntry = (e: CollectionEntry<'posts' | 'notes' | 'lab'>): Entry => ({
  slug: e.id.replace(/\.md$/, ''),
  title: e.data.title,
  // 序列化前转 ISO 串 —— data-ctx 走 JSON，Date 对象到客户端会变成 string
  date: e.data.date.toISOString(),
  anime: e.data.anime,
});
const ctx: Ctx = {
  posts: posts.map(toEntry),
  notes: notes.map(toEntry),
  lab: lab.map(toEntry),
};
---

<div id="cli" data-ctx={JSON.stringify(ctx)}>
  <div id="cli-output" aria-live="polite"></div>
  <div class="cli-input-row">
    <label class="prompt" for="cli-input" id="cli-prompt">v01d@cyber:~$</label>
    <input id="cli-input" autocomplete="off" spellcheck="false" enterkeyhint="go" />
  </div>
</div>

<style>
  #cli {
    margin: 8px 7% 40px;
    max-width: 1100px;
    font-size: 13px;
  }
  #cli-output .line { white-space: pre-wrap; line-height: 1.7; }
  #cli-output .line.cyan { color: var(--cyan); }
  #cli-output .line.green { color: var(--green); }
  #cli-output .line.err { color: #ff5f8f; }
  #cli-output .line.dim { color: var(--dim); }
  #cli-output .line.purple { color: var(--purple); }
  .cli-input-row { display: flex; gap: 8px; align-items: center; }
  .prompt { color: var(--green); white-space: nowrap; }
  #cli-input {
    flex: 1;
    background: transparent; border: none; outline: none;
    color: var(--fg);
    font: inherit;
    caret-color: var(--green);
  }
  #cli-input:focus { outline: none; }
</style>

<script>
  import { execCommand, makeState } from '../lib/commands';
  import { tabComplete } from '../lib/complete';
  import { withBase } from '../lib/base';

  const root = document.getElementById('cli');
  const output = document.getElementById('cli-output')!;
  const input = document.getElementById('cli-input') as HTMLInputElement;
  const promptEl = document.getElementById('cli-prompt')!;
  const ctx = JSON.parse(root!.dataset.ctx!);
  const state = makeState();

  // 提示符跟随 cwd：v01d@cyber:~$ ↔ v01d@cyber:~/posts$
  const updPrompt = () =>
    (promptEl.textContent = `v01d@cyber:${state.cwd ? '~/' + state.cwd : '~'}$`);
  // 候选列表即时输出（不走打字机，补全要快）
  const putLine = (text: string, cls: string) => {
    const el = document.createElement('div');
    el.className = `line ${cls}`;
    el.textContent = text;
    output.appendChild(el);
  };

  // grep 的全站索引：启动后拉取（纯静态 JSON，几十 KB）
  fetch(withBase('/search-index.json'))
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
    .then((search) => (ctx.search = search))
    .catch(() => {});

  // 打字机回显：每行逐字输出
  const typeLine = (text: string, cls: string) =>
    new Promise<void>((resolve) => {
      const el = document.createElement('div');
      el.className = `line ${cls}`;
      output.appendChild(el);
      let i = 0;
      const step = () => {
        el.textContent = text.slice(0, ++i);
        if (i < text.length) setTimeout(step, 10);
        else resolve();
      };
      step();
    });

  // readline：↑/↓ 遍历历史，Ctrl+R 反向搜索（每按一次跳到更早的一条匹配）
  let histIdx = -1; // -1 = 不在历史遍历中
  let draft = ''; // 遍历前的草稿，↓ 到底恢复
  let rQuery = ''; // Ctrl+R 固定的搜索词
  let rPos = -1; // 当前命中位置，下一次从这里往前找

  input.addEventListener('keydown', (e) => {
    if (e.isComposing) return;
    const h = state.history;
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (!h.length) return;
      if (histIdx === -1) {
        draft = input.value;
        histIdx = h.length;
      }
      histIdx = Math.max(0, histIdx - 1);
      input.value = h[histIdx] ?? '';
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (histIdx === -1) return;
      histIdx++;
      if (histIdx >= h.length) {
        histIdx = -1;
        input.value = draft;
      } else {
        input.value = h[histIdx];
      }
    } else if (e.ctrlKey && (e.key === 'r' || e.key === 'R')) {
      e.preventDefault(); // 拦住浏览器刷新
      if (rQuery !== input.value) {
        rQuery = input.value;
        rPos = h.length;
      }
      for (let i = rPos - 1; i >= 0; i--) {
        if (h[i].includes(rQuery)) {
          rPos = i;
          putLine(`(reverse-i-search)\`${rQuery}': ${h[i]}`, 'dim');
          input.value = h[i];
          return;
        }
      }
      putLine(`(reverse-i-search)\`${rQuery}': 没有更早的匹配`, 'dim');
    } else if (e.key !== 'Tab' && e.key !== 'Enter') {
      rQuery = ''; // 输入变了，下次 Ctrl+R 重新取词
    }
  });

  async function run(raw: string) {
    histIdx = -1;
    draft = '';
    await typeLine(`v01d@cyber:~$ ${raw}`, 'prompt');
    const result = execCommand(raw, state, ctx);
    for (const line of result.lines) {
      await typeLine(line.text, line.cls ?? '');
    }
    if (result.effect === 'clear') output.replaceChildren();
    if (result.effect === 'crt-toggle') {
      const el = document.documentElement;
      const off = el.dataset.crt === 'off';
      el.dataset.crt = off ? 'on' : 'off';
      try { localStorage.setItem('crt', off ? 'on' : 'off'); } catch {}
    }
    if (result.effect === 'wired') document.documentElement.classList.toggle('wired');
    if (result.effect === 'rmrf') {
      document.body.classList.add('rmrf');
      setTimeout(() => document.body.classList.remove('rmrf'), 1500);
      await typeLine('just kidding :)', 'dim');
    }
    if (result.effect === 'exit') {
      const main = document.querySelector('main');
      if (main) {
        main.style.transition = 'transform .35s, opacity .35s';
        main.style.transform = 'scale(.92)';
        main.style.opacity = '0';
        await new Promise((r) => setTimeout(r, 450));
        main.style.transform = '';
        main.style.opacity = '1';
        await typeLine('骗你的。哪也去不了。', 'dim');
      }
    }
    if (result.navigate) {
      const href = withBase(result.navigate.href);
      setTimeout(() => {
        // 同页锚点/回首页：SPA 滚动，不整页刷新（保住终端状态）
        if (href.includes('#')) {
          const target = document.getElementById(href.split('#')[1]!);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
            return;
          }
        }
        const home = withBase('/');
        if (href === home && location.pathname + location.search === home) {
          scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }
        location.href = href;
      }, 350);
    }
    updPrompt();
  }

  input.addEventListener('keydown', (e) => {
    // 拼音组合中的 Enter 是选字确认，不是执行命令
    if (e.isComposing) return;
    if (e.key === 'Enter' && input.value.trim()) {
      const v = input.value;
      input.value = '';
      run(v);
    }
    // Tab 补全：命令名 / 目录 / 文章路径
    if (e.key === 'Tab') {
      e.preventDefault();
      const { matches, insert } = tabComplete(input.value, ctx, state.cwd);
      if (insert !== null) input.value = insert;
      if (matches.length > 1) {
        putLine(`v01d@cyber:~$ ${input.value}`, 'prompt');
        putLine(matches.join('  '), 'dim');
      }
    }
  });

  // konami code: ↑↑↓↓←→←→BA → wired 模式切换
  const KONAMI = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let ki = 0;
  addEventListener('keydown', (e) => {
    ki = e.key === KONAMI[ki] ? ki + 1 : e.key === KONAMI[0] ? 1 : 0;
    if (ki === KONAMI.length) {
      ki = 0;
      document.documentElement.classList.toggle('wired');
      typeLine('↑↑↓↓←→←→BA — welcome to the WIRED.', 'purple');
    }
  });
</script>
