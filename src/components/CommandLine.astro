---
import type { Ctx, Entry } from '../lib/commands';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  notes: CollectionEntry<'notes'>[];
  lab: CollectionEntry<'lab'>[];
}
const { posts, notes, lab } = Astro.props;

const toEntry = (e: CollectionEntry<'posts' | 'notes' | 'lab'>): Entry => ({
  slug: e.id.replace(/\.md$/, ''),
  title: e.data.title,
  // 序列化前转 ISO 串 —— data-ctx 走 JSON，Date 对象到客户端会变成 string
  date: e.data.date.toISOString(),
  anime: e.data.anime,
});
const ctx: Ctx = {
  posts: posts.map(toEntry),
  notes: notes.map(toEntry),
  lab: lab.map(toEntry),
};
---

<div id="cli" data-ctx={JSON.stringify(ctx)}>
  <div id="cli-output" aria-live="polite"></div>
  <div class="cli-input-row">
    <label class="prompt" for="cli-input" id="cli-prompt">v01d@cyber:~$</label>
    <input id="cli-input" autocomplete="off" spellcheck="false" enterkeyhint="go" />
  </div>
</div>

<style>
  #cli {
    margin: 8px 7% 40px;
    max-width: 1100px;
    font-size: 13px;
  }
  #cli-output .line { white-space: pre-wrap; line-height: 1.7; }
  #cli-output .line.cyan { color: var(--cyan); }
  #cli-output .line.green { color: var(--green); }
  #cli-output .line.err { color: #ff5f8f; }
  #cli-output .line.dim { color: var(--dim); }
  #cli-output .line.purple { color: var(--purple); }
  .cli-input-row { display: flex; gap: 8px; align-items: center; }
  .prompt { color: var(--green); white-space: nowrap; }
  #cli-input {
    flex: 1;
    background: transparent; border: none; outline: none;
    color: var(--fg);
    font: inherit;
    caret-color: var(--green);
  }
  #cli-input:focus { outline: none; }
</style>

<script>
  import { execCommand, makeState } from '../lib/commands';
  import { tabComplete } from '../lib/complete';
  import { bgmToggle, bgmSetDucked } from '../lib/bgm';
  import { withBase } from '../lib/base';
  import { navigate } from 'astro:transitions/client';
  import { netSet, applyNet, netOn } from '../lib/net';
  import { visit, readFinger, webStores, isNight } from '../lib/visitor';
  import { keyClick, keysoundOn, keysoundSetEnabled } from '../lib/keysound';
  import { bgmPowerCut } from '../lib/bgm';
  import { whisperFor } from '../lib/whisper';

  // 连接态总闸：写偏好 → 重放 <html> → BGM 退远/恢复 → 广播（hero 即时换台）
  const netGo = (on: boolean) => {
    const { ls } = webStores();
    netSet(ls, on);
    applyNet(document.documentElement, ls);
    bgmSetDucked(on);
    dispatchEvent(new CustomEvent('net:change', { detail: on }));
  };

  // 终端初始化：虚拟导航回首页时 DOM 是新的，需重绑。本脚本整个生命周期
  // 只执行一次（ClientRouter 去重），靠 astro:page-load 反复 init；
  // 冷加载时脚本先于 astro:page-load 执行，直接调一次（marker 防双绑）
  let konamiAC: AbortController | null = null;
  let printAC: AbortController | null = null;
  // idle 低语的计时器跨 init 共享（虚拟导航换 body 后旧闭包自然失效）
  let idleTimer: ReturnType<typeof setTimeout> | undefined;
  let lastWhisper = 0;
  const init = () => {
    const root = document.getElementById('cli');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    const output = document.getElementById('cli-output')!;
    const input = document.getElementById('cli-input') as HTMLInputElement;
    const promptEl = document.getElementById('cli-prompt')!;
    const ctx = JSON.parse(root.dataset.ctx!);
    const state = makeState();
    // 访客记忆注入：whoami 按会话代数演化；who 的指纹当场采样
    state.whoamiN = visit(webStores().ls, webStores().ss, Date.now()).n;
    ctx.finger = readFinger(
      navigator,
      { screen, devicePixelRatio },
      Intl.DateTimeFormat().resolvedOptions().timeZone
    );

    // 外部台词通道：footer 倒计时点击 → term:print → 打字机输出
    printAC?.abort();
    printAC = new AbortController();
    addEventListener(
      'term:print',
      (e) => {
        const line = (e as CustomEvent<string>).detail;
        if (!line) return;
        input.focus();
        typeLine(line, 'purple');
      },
      { signal: printAC.signal }
    );

    // 提示符跟随 cwd：v01d@cyber:~$ ↔ v01d@cyber:~/posts$
    const updPrompt = () =>
      (promptEl.textContent = `v01d@cyber:${state.cwd ? '~/' + state.cwd : '~'}$`);
    // 候选列表即时输出（不走打字机，补全要快）
    const putLine = (text: string, cls: string) => {
      const el = document.createElement('div');
      el.className = `line ${cls}`;
      el.textContent = text;
      output.appendChild(el);
    };

    // grep 的全站索引：启动后拉取（纯静态 JSON，几十 KB）
    fetch(withBase('/search-index.json'))
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((search) => (ctx.search = search))
      .catch(() => {});

    // 打字机回显：每行逐字输出
    const typeLine = (text: string, cls: string) =>
      new Promise<void>((resolve) => {
        const el = document.createElement('div');
        el.className = `line ${cls}`;
        output.appendChild(el);
        let i = 0;
        const step = () => {
          el.textContent = text.slice(0, ++i);
          if (i < text.length) setTimeout(step, 10);
          else resolve();
        };
        step();
      });

    // idle 低语：60s 没人动终端自言自语（深夜更想说话），一动就闭嘴；3 分钟冷却
    const armIdle = () => {
      clearTimeout(idleTimer);
      idleTimer = setTimeout(async () => {
        if (!document.contains(input)) return;
        const now = Date.now();
        if (now - lastWhisper >= 180000) {
          const w = whisperFor(Math.floor(now / 60000), isNight(new Date()));
          if (w) {
            lastWhisper = now;
            await typeLine(w, 'purple');
          }
        }
        armIdle();
      }, 60000);
    };

    // readline：↑/↓ 遍历历史，Ctrl+R 反向搜索（每按一次跳到更早的一条匹配）
    let histIdx = -1; // -1 = 不在历史遍历中
    let draft = ''; // 遍历前的草稿，↓ 到底恢复
    let rQuery = ''; // Ctrl+R 固定的搜索词
    let rPos = -1; // 当前命中位置，下一次从这里往前找

    input.addEventListener('keydown', (e) => {
      if (e.isComposing) return;
      // 打字机音效：普通字符键才响（修饰键/方向键不响）
      if (!e.ctrlKey && !e.metaKey && !e.altKey && e.key.length === 1) keyClick();
      // 环境感知广播：hero 数据雨听终端的（打字加速下落）
      if (e.key.length === 1) dispatchEvent(new CustomEvent('term:activity', { detail: { kind: 'type' } }));
      armIdle();
      const h = state.history;
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (!h.length) return;
        if (histIdx === -1) {
          draft = input.value;
          histIdx = h.length;
        }
        histIdx = Math.max(0, histIdx - 1);
        input.value = h[histIdx] ?? '';
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (histIdx === -1) return;
        histIdx++;
        if (histIdx >= h.length) {
          histIdx = -1;
          input.value = draft;
        } else {
          input.value = h[histIdx];
        }
      } else if (e.ctrlKey && (e.key === 'r' || e.key === 'R')) {
        e.preventDefault(); // 拦住浏览器刷新
        if (rQuery !== input.value) {
          rQuery = input.value;
          rPos = h.length;
        }
        for (let i = rPos - 1; i >= 0; i--) {
          if (h[i].includes(rQuery)) {
            rPos = i;
            putLine(`(reverse-i-search)\`${rQuery}': ${h[i]}`, 'dim');
            input.value = h[i];
            return;
          }
        }
        putLine(`(reverse-i-search)\`${rQuery}': 没有更早的匹配`, 'dim');
      } else if (e.key !== 'Tab' && e.key !== 'Enter') {
        rQuery = ''; // 输入变了，下次 Ctrl+R 重新取词
      }
    });

    async function run(raw: string) {
      histIdx = -1;
      draft = '';
      // 环境感知广播：grep 时雨滴短暂变成关键词字符（满屏都是你找的词）
      const first = raw.trim().split(/\s+/)[0];
      if (first === 'grep') {
        const q = raw.trim().slice(first.length).split('|')[0]!.trim();
        if (q) dispatchEvent(new CustomEvent('term:activity', { detail: { kind: 'grep', text: q } }));
      }
      await typeLine(`v01d@cyber:~$ ${raw}`, 'prompt');
      const result = execCommand(raw, state, ctx);
      for (const line of result.lines) {
        await typeLine(line.text, line.cls ?? '');
      }
      if (result.effect === 'clear') output.replaceChildren();
      if (result.effect === 'bgm-toggle') {
        const st = await bgmToggle();
        if (st === 'missing')
          await typeLine(
            '[mpg123] error: 打不开 ~/audio/duvet.mp3 —— 文件不存在（见 README「BGM」一节）',
            'err'
          );
      }
      if (result.effect === 'crt-toggle') {
        const el = document.documentElement;
        const off = el.dataset.crt === 'off';
        el.dataset.crt = off ? 'on' : 'off';
        try { localStorage.setItem('crt', off ? 'on' : 'off'); } catch {}
      }
      if (result.effect === 'wired') netGo(!netOn(webStores().ls));
      if (result.effect === 'keysound-toggle') {
        const { ls } = webStores();
        const next = !keysoundOn(ls);
        keysoundSetEnabled(next, ls);
        await typeLine(
          next ? 'keysound: on —— 听，每次击键都有了重量' : 'keysound: off —— 安静了。键盘还在，只是你不听了',
          'dim'
        );
      }
      if (result.effect === 'net-on') netGo(true);
      if (result.effect === 'net-off') netGo(false);
      if (result.effect === 'poweroff') {
        await bgmPowerCut();
        document.body.classList.add('poweroff');
        await new Promise((r) => setTimeout(r, 2100));
        document.body.classList.remove('poweroff');
        document.body.classList.add('poweron');
        setTimeout(() => document.body.classList.remove('poweron'), 700);
        await typeLine('reboot: CRT ok · wired ok · ghost ok · 你还在，好。', 'green');
      }
      if (result.effect === 'rmrf') {
        document.body.classList.add('rmrf');
        setTimeout(() => document.body.classList.remove('rmrf'), 1500);
        await typeLine('just kidding :)', 'dim');
      }
      if (result.effect === 'exit') {
        const main = document.querySelector('main');
        if (main) {
          main.style.transition = 'transform .35s, opacity .35s';
          main.style.transform = 'scale(.92)';
          main.style.opacity = '0';
          await new Promise((r) => setTimeout(r, 450));
          main.style.transform = '';
          main.style.opacity = '1';
          await typeLine('骗你的。哪也去不了。', 'dim');
        }
      }
      if (result.navigate) {
        const href = withBase(result.navigate.href);
        setTimeout(() => {
          // 同页锚点/回首页：SPA 滚动，不导航（保住终端状态）
          if (href.includes('#')) {
            const target = document.getElementById(href.split('#')[1]!);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth' });
              return;
            }
          }
          const home = withBase('/');
          if (href === home && location.pathname + location.search === home) {
            scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }
          navigate(href); // 客户端路由：BGM 不断
        }, 350);
      }
      updPrompt();
    }

    input.addEventListener('keydown', (e) => {
      // 拼音组合中的 Enter 是选字确认，不是执行命令
      if (e.isComposing) return;
      if (e.key === 'Enter' && input.value.trim()) {
        const v = input.value;
        input.value = '';
        run(v);
      }
      // Tab 补全：命令名 / 目录 / 文章路径
      if (e.key === 'Tab') {
        e.preventDefault();
        const { matches, insert } = tabComplete(input.value, ctx, state.cwd);
        if (insert !== null) input.value = insert;
        if (matches.length > 1) {
          putLine(`v01d@cyber:~$ ${input.value}`, 'prompt');
          putLine(matches.join('  '), 'dim');
        }
      }
    });

    // konami code: ↑↑↓↓←→←→BA → wired 模式切换（挂在 window 上，重绑前撤旧）
    konamiAC?.abort();
    konamiAC = new AbortController();
    const KONAMI = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let ki = 0;
    addEventListener(
      'keydown',
      (e) => {
        ki = e.key === KONAMI[ki] ? ki + 1 : e.key === KONAMI[0] ? 1 : 0;
        if (ki === KONAMI.length) {
          ki = 0;
          netGo(!netOn(webStores().ls));
          typeLine('↑↑↓↓←→←→BA — welcome to the WIRED.', 'purple');
        }
      },
      { signal: konamiAC.signal }
    );
  };

  document.addEventListener('astro:page-load', init);
  init();
</script>
