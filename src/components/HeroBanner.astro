---
import { art } from '../lib/art';
import { withBase } from '../lib/base';

// 轮换池：lain / EVA 系列为主力（TV / EOE / 终章），其余经典轮换
const slugs = ['lain', 'evangelion', 'eva_eoe', 'eva_310', 'gits', 'bebop', 'psychopass', 'akira'];
const pick = slugs[Math.floor(Math.random() * slugs.length)];
const info = art(pick);
const banner = info ? withBase(`/art/${info.banner}`) : '';
const credit = info?.title ?? '';
// 浏览器端轮换池：slug|标题，脚本解析
const pool = slugs
  .map((s) => {
    const a = art(s);
    return a ? `${s}|${a.title}` : null;
  })
  .filter(Boolean)
  .join(',');
// 深夜池：0:00–4:59 只换这三张（0:00 入夜 glitch 进池，5:00 天亮换回）
const nightPool = ['lain', 'paranoia', 'perfect_blue']
  .map((s) => {
    const a = art(s);
    return a ? `${s}|${a.title}` : null;
  })
  .filter(Boolean)
  .join(',');
---
<section class="hero" data-hero data-pool={pool} data-night-pool={nightPool} data-current={pick} style={`background-image:url(${banner})`}>
  <div class="hero-veil"></div>
  <div class="hero-text">
    <h1>v01d@cyber<span class="cursor">_</span></h1>
    <p class="hero-sub">present and connected — ghost in the shell / 技术笔记 × 名作考据</p>
  </div>
  <span class="hero-credit">{credit}</span>
  <canvas class="hero-rain" aria-hidden="true"></canvas>
</section>

<style>
  .hero {
    position: relative;
    height: clamp(240px, 38vh, 420px);
    background: center 30% / cover no-repeat;
    overflow: hidden;
  }
  .hero::before,
  .hero::after {
    /* glitch 双影：与主背景同图，仅在 glitching 时显现 */
    content: '';
    position: absolute; inset: 0;
    background: inherit;
    background-position: center 30%;
    opacity: 0;
    pointer-events: none;
  }
  .hero.glitching::before {
    opacity: 0.8;
    animation: glitch-1 0.45s steps(2) infinite, glitch-shift-r 0.45s steps(2) infinite;
    filter: hue-rotate(90deg) saturate(2);
  }
  .hero.glitching::after {
    opacity: 0.8;
    animation: glitch-1 0.33s steps(2) reverse infinite, glitch-shift-l 0.4s steps(2) infinite;
    filter: hue-rotate(-60deg);
  }
  @keyframes glitch-shift-r {
    0%, 100% { transform: translate(6px, 0); }
    50% { transform: translate(-9px, 2px); }
  }
  @keyframes glitch-shift-l {
    0%, 100% { transform: translate(-7px, 1px); }
    50% { transform: translate(8px, -2px); }
  }
  .hero-veil {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(4, 8, 15, 0.25), rgba(4, 8, 15, 0.35) 55%, var(--bg));
  }
  .hero-text { position: absolute; left: 7%; right: 6%; bottom: 16px; z-index: 2; }
  .hero-text h1 {
    font-size: clamp(20px, 3.4vw, 34px);
    letter-spacing: 2px;
    color: var(--fg);
    text-shadow: 0 0 14px rgba(138, 216, 255, 0.8);
  }
  .cursor { color: var(--green); animation: blink 1.1s infinite; }
  .hero-sub { color: var(--cyan); font-size: 12px; opacity: 0.85; margin-top: 4px; }
  .hero-credit {
    position: absolute; right: 10px; bottom: 6px; z-index: 2;
    font-size: 9px; color: rgba(255, 255, 255, 0.35);
  }
  .hero-rain { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; }
</style>

<script>
  import { withBase } from '../lib/base';
  import { netOn } from '../lib/net';
  import { webStores, visit, greeting, isNight } from '../lib/visitor';
  import { nextEvent } from '../lib/countdown';

  // 虚拟导航回首页时 hero 是新元素，page-load 重绑；旧 hero 的定时器/监听一并撤掉
  let heroAC: AbortController | null = null;
  const init = () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero || hero.dataset.ready) return;
    hero.dataset.ready = '1';

    heroAC?.abort();
    heroAC = new AbortController();
    const { signal } = heroAC;

    // Present Day 时间流：副标题活的（分钟级 + 连接/深夜变体）。
    // 是内容不是动效，prefers-reduced-motion 也照常走
    const sub = hero.querySelector<HTMLElement>('.hero-sub');
    const paintSub = () => {
      if (!sub) return;
      const { ls, ss } = webStores();
      sub.textContent = greeting(visit(ls, ss, Date.now()), new Date(), netOn(ls));
    };
    paintSub();
    const subTimer = setInterval(() => {
      if (!hero.isConnected) {
        clearInterval(subTimer);
        return;
      }
      paintSub();
    }, 30000);
    signal.addEventListener('abort', () => clearInterval(subTimer));
    addEventListener('net:change', paintSub, { signal });
    addEventListener('night:change', paintSub, { signal });

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    const parse = (attr?: string): Array<[string, string]> =>
      (attr ?? '')
        .split(',')
        .filter(Boolean)
        .map((s) => s.split('|') as [string, string]);
    const pool = parse(hero.dataset.pool);
    const nightPool = parse(hero.dataset.nightPool);
    let cur = hero.dataset.current ?? '';

    const swapTo = (slug: string, title: string) => {
      const img = new Image();
      img.onload = () => {
        hero.style.backgroundImage = `url(${withBase(`/art/${slug}_banner.jpg`)})`;
        const credit = hero.querySelector('.hero-credit');
        if (credit) credit.textContent = title;
      };
      img.src = withBase(`/art/${slug}_banner.jpg`);
    };
    const glitchTo = (slug: string, title: string) => {
      hero.classList.add('glitching');
      setTimeout(() => swapTo(slug, title), 300);
      setTimeout(() => hero.classList.remove('glitching'), 650);
    };

    // 锁定态优先级：wired（用户主动连接，最高）> 纪念日 T-0 > 深夜池 > 日间轮换
    const lockOf = (): [string, string] | null => {
      if (netOn(webStores().ls)) return pool.find(([s]) => s === 'lain') ?? null;
      const doom = nextEvent(new Date());
      if (doom && doom.days === 0) {
        return (
          pool.find(([s]) => s === doom.event.slug) ??
          nightPool.find(([s]) => s === doom.event.slug) ??
          null
        );
      }
      return null;
    };
    const activePool = () => (isNight(new Date()) ? nightPool : pool);
    const step = () => {
      const lock = lockOf();
      if (lock) {
        if (lock[0] !== cur) {
          cur = lock[0];
          glitchTo(cur, lock[1]);
        }
        return;
      }
      const p = activePool();
      if (!p.length) return;
      const i = p.findIndex(([s]) => s === cur);
      const [slug, title] = p[(i + 1) % p.length]!;
      cur = slug;
      glitchTo(slug, title);
    };

    // 首屏/入夜/天亮立刻归位：有锁（wired / T-0）立即锁，无锁且不在当前池就 glitch 进池
    const enter = () => {
      const lock = lockOf();
      if (lock) {
        if (lock[0] !== cur) {
          cur = lock[0];
          glitchTo(lock[0], lock[1]);
        }
        return;
      }
      const p = activePool();
      if (p.some(([s]) => s === cur)) return;
      const pick = p[Math.floor(Math.random() * p.length)];
      if (pick) {
        cur = pick[0];
        glitchTo(pick[0], pick[1]);
      }
    };

    // 定时 glitch 换图
    const timer = setInterval(() => {
      if (!hero.isConnected) {
        clearInterval(timer);
        return;
      }
      step();
    }, 9000);
    signal.addEventListener('abort', () => clearInterval(timer));

    // connect/disconnect、入夜/天亮：即时换台，不等下一个 tick
    addEventListener('net:change', step, { signal });
    addEventListener('night:change', enter, { signal });
    enter();

    // 数据雨：低密度低透明度，滚出视口即停
    const canvas = hero.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const resize = () => {
      canvas.width = hero.clientWidth;
      canvas.height = hero.clientHeight;
    };
    resize();
    addEventListener('resize', resize, { signal });

    const CHARS = '0101010<>[]{}/\\#$%&*+=~^?!aidlne';
    const drops = Array.from({ length: Math.ceil(canvas.width / 26) }, () => ({
      y: Math.random() * canvas.height,
      v: 0.3 + Math.random() * 0.5,
      c: CHARS[Math.floor(Math.random() * CHARS.length)],
    }));

    let raf = 0;
    let running = false;
    const draw = () => {
      if (!running) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.font = '12px monospace';
      drops.forEach((d, i) => {
        ctx.fillStyle = 'rgba(125,255,176,0.16)';
        ctx.fillText(d.c, i * 26 + 8, d.y);
        d.y += d.v;
        if (d.y > canvas.height + 20) d.y = -10;
        if (Math.random() < 0.02) d.c = CHARS[Math.floor(Math.random() * CHARS.length)];
      });
      raf = requestAnimationFrame(draw);
    };
    const start = () => { if (!running) { running = true; draw(); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };
    const io = new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()));
    io.observe(hero);
    signal.addEventListener('abort', () => {
      stop();
      io.disconnect();
    });
  };

  document.addEventListener('astro:page-load', init);
  init();
</script>

