---
import TerminalShell from '../layouts/TerminalShell.astro';
import HeroBanner from '../components/HeroBanner.astro';
import PostList from '../components/PostList.astro';
import CommandLine from '../components/CommandLine.astro';
import BootSequence from '../components/BootSequence.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', (c) => !c.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const notes = (await getCollection('notes', (c) => !c.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const lab = (await getCollection('lab', (c) => !c.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<TerminalShell title="v01d@cyber — ghost in the shell">
  <BootSequence />
  <HeroBanner />
  <div class="whoami">
    <p><span class="prompt">$</span> whoami</p>
    <p class="answer">web 渗透 × 内网安全 × shellcode 免杀，业余赛璐璐考古学家。这里栖着技术笔记、随笔、项目和一切 wired 的念头。</p>
  </div>
  <PostList posts={posts} notes={notes} lab={lab} />
  <CommandLine posts={posts} notes={notes} lab={lab} />
</TerminalShell>

<style>
  .whoami { padding: 16px 7% 0; max-width: 1100px; font-size: 13px; }
  .whoami .prompt { color: var(--green); }
  .whoami .answer { color: var(--fg); opacity: 0.85; margin-top: 4px; }
</style>
